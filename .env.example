# Copy to backend/.env (or export in your shell). Never commit real keys.

# Provider credentials. Optional: without them only the built-in mock provider is available.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown). Relative paths resolve from backend/.
# EVAL_HARNESS_DATABASE_URL=sqlite+aiosqlite:///data/eval_harness.db
# EVAL_HARNESS_PRICING_FILE=pricing.json
# EVAL_HARNESS_SEED_EXAMPLES=true
# EVAL_HARNESS_DEFAULT_CONCURRENCY=4
# EVAL_HARNESS_MAX_CONCURRENCY=32
# EVAL_HARNESS_REQUEST_TIMEOUT=60
# EVAL_HARNESS_MOCK_LATENCY_SCALE=1.0
# EVAL_HARNESS_CORS_ORIGINS=["http://localhost:3000"]

# Frontend (read by the Next.js server when proxying /api to the backend):
# EVAL_HARNESS_API_URL=http://127.0.0.1:8000
